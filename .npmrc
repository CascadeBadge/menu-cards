# Workaround for an npm 10 crash (TypeError: Cannot read properties of null
# reading 'edgesOut' in arborist #loadPeerSet) triggered by the vitest 4.x
# peer-dependency graph pulled in via vite 8's @vitejs/devtools chain.
# legacy-peer-deps skips the strict peer resolution step that crashes.
# Do NOT remove this unless the underlying npm bug is fixed.
legacy-peer-deps=true
